#!/usr/bin/env python3
"""Entry point. Resolves its own location (following symlinks) so the pdxaudit
package sits on the path, then hands off to the CLI. Install with:
    ln -s /path/to/pdx-audit ~/.local/bin/pdx-audit
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
# pdx_utilities is the shared sibling checkout (../pdx-utilities), not vendored.
_shared = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "pdx-utilities")
if os.path.isdir(_shared):
    sys.path.insert(1, _shared)

from pdxaudit.cli import main

if __name__ == "__main__":
    main()
